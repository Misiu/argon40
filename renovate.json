{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": ["develop"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": ["required-version = \"==(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the test harness for the declared minimum Home Assistant release",
      "matchPackageNames": ["pytest-homeassistant-custom-component"],
      "matchCurrentVersion": "0.13.201",
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ]
}
