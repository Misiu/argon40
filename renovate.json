{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": ["develop"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customDatasources": {
    "home-assistant-python": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/home-assistant/core/master/.python-version",
      "format": "plain"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": ["required-version = \"==(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Follow the Python major and minor version used by stable Home Assistant",
      "matchManagers": ["pyenv"],
      "matchPackageNames": ["python"],
      "overrideDatasource": "custom.home-assistant-python",
      "extractVersion": "^(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioning": "pep440",
      "automerge": false
    },
    {
      "description": "Keep the test harness for the declared minimum Home Assistant release",
      "matchPackageNames": ["pytest-homeassistant-custom-component"],
      "matchCurrentVersion": "0.13.344",
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ]
}
